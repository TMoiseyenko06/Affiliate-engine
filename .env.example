# -----------------------------------------------------------------------------
# Affiliate Engine environment variables.
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Load it into your shell before running: `set -a; source .env; set +a`
# -----------------------------------------------------------------------------

# --- Content strategy ---
# Comma-separated niches; the first is the primary niche.
NICHES=home_organization
# Target mix across three content types (normalized automatically if they
# don't sum to 1.0, so slightly-off values won't crash anything):
#   affiliate             - product pin with a title/pain-point overlay
#   affiliate_image_only  - same product pipeline, but NO text drawn on the
#                            image at all; the product photo speaks for itself
#   organic               - no product, no link, pure niche value content
# Defaults to an even three-way split.
TARGET_AFFILIATE_RATIO=0.333
TARGET_AFFILIATE_IMAGE_ONLY_RATIO=0.333
TARGET_ORGANIC_RATIO=0.334
DAILY_POST_COUNT=4
# How many recent posts to consider when computing the actual ratio.
RATIO_LOOKBACK_POSTS=20

# --- Product reuse policy ---
# "permanent" (default): never re-post the same product once it's been
# posted successfully. "cooldown": a product becomes eligible again after
# REUSE_LOOKBACK_DAYS (the old behavior). Only affects PRODUCT reuse —
# organic topic rotation always uses the cooldown window below regardless.
PRODUCT_REUSE_MODE=permanent
# Cooldown window in days: used when PRODUCT_REUSE_MODE=cooldown, and always
# used for organic topic rotation and as a final "don't post the exact same
# thing you just posted" safety net in the verifier.
REUSE_LOOKBACK_DAYS=14
# In permanent mode, if a niche's entire product catalog has already been
# posted, fall back to re-posting the least-recently-used one (and alert)
# instead of stalling the pipeline. Set false to hard-stop/skip instead.
PRODUCT_REUSE_FALLBACK_ENABLED=true

# --- Amazon Associates ---
AMAZON_ASSOCIATES_TAG=yourtag-20
AFFILIATE_DISCLOSURE_TEXT=As an Amazon Associate I earn from qualifying purchases.

# --- OpenRouter (scout / copywriter / creative / verifier) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model slugs drift over time; check https://openrouter.ai/models
# for current IDs if a call 404s ("No endpoints found ...").
SCOUT_MODEL=openai/gpt-4o-mini
COPYWRITER_MODEL=anthropic/claude-sonnet-5
# Reasons about a concrete in-use demonstration scene before Higgsfield is
# called (e.g. "spice jars on a rack, hand sprinkling seasoning onto food"
# instead of a generic product-on-white shot). Falls back to a simpler static
# prompt if this call fails, so a missing/invalid key never blocks a cycle.
CREATIVE_MODEL=anthropic/claude-sonnet-5
# IMPORTANT: keep the verifier model different from the copywriter/orchestrator
# so verification is an independent check, not self-review.
VERIFIER_MODEL=openai/gpt-4o-mini
# Image-editing model used to place a real product photo into a generated
# in-use scene while preserving the product's exact appearance (see README
# "Product imagery"). Verified against OpenRouter's own Image API docs.
OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image

# --- Higgsfield (image generation) ---
# Public API is asynchronous (submit job -> poll). Get a key+secret pair at
# cloud.higgsfield.ai. Auth is BOTH values joined as "Key {key}:{secret}" —
# a single key alone will 401.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
# Full model_id as shown in the Higgsfield dashboard, e.g. higgsfield-ai/soul/standard
HIGGSFIELD_MODEL_ID=higgsfield-ai/soul/standard
# Model-quality tier; check the model's page in the dashboard for accepted values.
HIGGSFIELD_RESOLUTION=1080p
HIGGSFIELD_POLL_INTERVAL_SECONDS=3
HIGGSFIELD_POLL_TIMEOUT_SECONDS=180
# NOT currently used by the default pipeline: when a real product photo is
# available it's used directly (see README "Product imagery"), bypassing
# Higgsfield entirely, since reference-guided generation cannot reliably
# preserve an exact product's appearance. Kept for HiggsfieldClient callers
# that explicitly opt into reference-guided generation anyway.
HIGGSFIELD_IMAGE_PARAM=image

# --- Pinterest board (needed regardless of how posting happens) ---
PINTEREST_BOARD_ID=

# --- Zernio (https://zernio.com) — third-party scheduler used for both
# posting to Pinterest and pulling analytics. Pinterest's own API is not
# called anywhere in this pipeline. Set up the Pinterest connection once via
# Zernio's own OAuth "Connecting Accounts" flow, then copy the resulting
# account ID here.
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_PINTEREST_ACCOUNT_ID=
# How many days back analytics_pull.py requests on each run.
ANALYTICS_LOOKBACK_DAYS=30

# --- Amazon product candidate source (optional) ---
# JSON endpoint returning candidate products; if unset, a built-in seed list is used.
PRODUCT_SOURCE_URL=

# --- Amazon product image sourcing (interim, until PA-API is wired up) ---
# ScraperAPI (https://scraperapi.com) — third-party scraping/proxy service,
# used because PA-API needs an approved Associates account with qualifying
# sales, which isn't available yet. Has a free tier (1,000 credits). Tried
# BEFORE the direct-scrape fallback below via ScraperAPI's structured Amazon
# product endpoint (returns real product JSON, not HTML to parse).
SCRAPERAPI_KEY=
SCRAPERAPI_COUNTRY=us
# Direct HTTP scrape fallback — CONFIRMED NON-VIABLE: plain HTTP scraping is
# blocked outright by Amazon's bot wall (verified from two independent
# networks). Disabled by default; only enable if you have your own working
# scraping strategy on top of this.
SCRAPE_PRODUCT_IMAGES=false
# Manual testing override: a real image URL used as the product reference
# photo when no scraped image is available. Lets you test the compositor +
# Higgsfield reference-image flow with real imagery. NOT for production use —
# it applies the same image to every affiliate product.
TEST_PRODUCT_IMAGE_URL=

# Manual testing override: force every affiliate cycle to use this exact
# Amazon product (any URL form works, including a.co/amzn.to short links —
# they're resolved to the canonical amazon.com/dp/ASIN form automatically),
# bypassing ranking and the reuse-window check. Lets you repeatedly test one
# specific listing instead of whichever product the ranking step picks.
# NOT for production — every cycle would promote the same product. Optional
# TEST_FORCE_PRODUCT_TITLE only matters if the ASIN isn't already in the
# built-in seed list (which has richer real feature data).
TEST_FORCE_PRODUCT_URL=
TEST_FORCE_PRODUCT_TITLE=

# --- Storage ---
DATABASE_URL=sqlite:///affiliate_engine.db

# --- Budget / rate caps (per day) ---
OPENROUTER_DAILY_CALL_CAP=200
HIGGSFIELD_DAILY_CALL_CAP=20

# --- Alerting ---
ALERT_FILE_PATH=alerts.log
DEADMAN_HOURS=12
# Optional Slack-compatible webhook for alerts.
ALERT_WEBHOOK_URL=

# --- Networking ---
HTTP_TIMEOUT_SECONDS=60
