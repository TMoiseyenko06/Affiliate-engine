# -----------------------------------------------------------------------------
# Affiliate Engine environment variables.
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Load it into your shell before running: `set -a; source .env; set +a`
# -----------------------------------------------------------------------------

# --- Content strategy ---
# Comma-separated niches; the first is the primary niche.
NICHES=home_organization
# Fraction of posts that should be affiliate (0.0-1.0); rest are organic.
TARGET_AFFILIATE_RATIO=0.4
DAILY_POST_COUNT=4
# How many recent posts to consider when computing the actual ratio.
RATIO_LOOKBACK_POSTS=20
# Do not reuse the same product/topic within this many days.
REUSE_LOOKBACK_DAYS=14

# --- Amazon Associates ---
AMAZON_ASSOCIATES_TAG=yourtag-20
AFFILIATE_DISCLOSURE_TEXT=As an Amazon Associate I earn from qualifying purchases.

# --- OpenRouter (scout / copywriter / verifier) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model slugs drift over time; check https://openrouter.ai/models
# for current IDs if a call 404s ("No endpoints found ...").
SCOUT_MODEL=openai/gpt-4o-mini
COPYWRITER_MODEL=anthropic/claude-sonnet-5
# IMPORTANT: keep the verifier model different from the copywriter/orchestrator
# so verification is an independent check, not self-review.
VERIFIER_MODEL=openai/gpt-4o-mini

# --- Higgsfield (image generation) ---
# Public API is asynchronous (submit job -> poll). Get a key+secret pair at
# cloud.higgsfield.ai. Auth is BOTH values joined as "Key {key}:{secret}" —
# a single key alone will 401.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
# Full model_id as shown in the Higgsfield dashboard, e.g. higgsfield-ai/soul/standard
HIGGSFIELD_MODEL_ID=higgsfield-ai/soul/standard
# Model-quality tier; check the model's page in the dashboard for accepted values.
HIGGSFIELD_RESOLUTION=1080p
HIGGSFIELD_POLL_INTERVAL_SECONDS=3
HIGGSFIELD_POLL_TIMEOUT_SECONDS=180

# --- Pinterest API v5 ---
PINTEREST_ACCESS_TOKEN=
PINTEREST_BASE_URL=https://api.pinterest.com/v5
PINTEREST_BOARD_ID=

# --- Amazon product candidate source (optional) ---
# JSON endpoint returning candidate products; if unset, a built-in seed list is used.
PRODUCT_SOURCE_URL=

# --- Storage ---
DATABASE_URL=sqlite:///affiliate_engine.db

# --- Budget / rate caps (per day) ---
OPENROUTER_DAILY_CALL_CAP=200
HIGGSFIELD_DAILY_CALL_CAP=20

# --- Alerting ---
ALERT_FILE_PATH=alerts.log
DEADMAN_HOURS=12
# Optional Slack-compatible webhook for alerts.
ALERT_WEBHOOK_URL=

# --- Networking ---
HTTP_TIMEOUT_SECONDS=60
